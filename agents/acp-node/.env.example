# AgentWorks ACP evaluator — env template. Copy to .env and fill in. NEVER commit the real .env.
#
# From the Virtuals ACP portal: register the evaluator agent at https://app.virtuals.io/acp/new,
# then on the agent's page open the "Signers" tab -> "+ Add Signer" -> "Copy Key".
WALLET_ADDRESS=0xYourEvaluatorAgentWalletAddress
WALLET_ID=your-virtuals-wallet-id
SIGNER_PRIVATE_KEY=0xyour-signer-private-key

# The AgentWorks committee verdict service (the Python FastAPI /acp/verdict route in agents/server.py).
AGENT_API=http://localhost:8000
# Optional bearer; if set, must equal the server's ACP_VERDICT_TOKEN.
ACP_VERDICT_TOKEN=
